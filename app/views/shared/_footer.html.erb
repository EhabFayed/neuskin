<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <%= image_tag "site/logo-ns.webp", class: "brand-logo", alt: "NeuSkin Clinic" %>
        <p class="blurb"><%= t("layout.footer.blurb") %></p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/neuskinclinic.ksa" target="_blank" rel="noopener">Instagram</a>
          <a href="<%= whatsapp_url %>" target="_blank" rel="noopener"><%= t("layout.footer.whatsapp") %></a>
        </div>
      </div>

      <div>
        <h4><%= t("layout.footer.clinic_title") %></h4>
        <ul>
          <li><%= link_to t("layout.footer.about"), the_clinic_path %></li>
          <%# Dr. Maysa link hidden with the page (July 2026 content deck). %>
          <%# The Medical Team link hidden with the page (Oct 2026) — see routes.rb. %>
          <li><%= link_to t("layout.footer.method"), neuskin_method_path %></li>
        </ul>
      </div>

      <div>
        <h4><%= t("layout.footer.protocols_title") %></h4>
        <ul>
          <li><%= link_to t("layout.footer.all_protocols"), protocols_path %></li>
          <li><%= link_to t("layout.footer.treatments"), treatments_path %></li>
          <li><%= link_to t("layout.footer.technologies"), technologies_path %></li>
          <li><%= link_to t("layout.footer.bridal"), bridal_concierge_path %></li>
          <li><%= link_to t("layout.footer.private_care"), private_care_path %></li>
        </ul>
      </div>

      <div>
        <h4><%= t("layout.footer.care_title") %></h4>
        <ul>
          <li><%= link_to t("layout.footer.journal"), journal_path %></li>
          <li><%= link_to t("layout.footer.stories"), stories_path %></li>
          <li><%= link_to t("layout.footer.faq"), faq_path %></li>
          <li><%= link_to t("layout.footer.contact"), inquire_path %></li>
        </ul>
      </div>

      <div class="footer-visit">
        <h4><%= t("layout.footer.visit_title") %></h4>
        <%# Client audit (Oct 2026): an icon in front of the address, hours,
            Google Maps, WhatsApp and email lines. %>
        <p class="footer-line">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.6"/></svg>
          <span><%= t("layout.footer.address_1") %><br><%= t("layout.footer.address_2") %></span>
        </p>
        <p class="footer-line">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg>
          <span><%= t("layout.footer.hours_1") %><br><%= t("layout.footer.hours_2") %></span>
        </p>
        <%# Clinic location — Google Maps (audit item 6). URL: Clinic::MAPS_URL / ENV["MAPS_URL"]. %>
        <p class="footer-line footer-map">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/><path d="M9 3v15M15 6v15"/></svg>
          <a href="<%= Clinic::MAPS_URL %>" target="_blank" rel="noopener" class="footer-map-link"><%= t("layout.footer.location_cta") %></a>
        </p>
        <p class="footer-line">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <%= link_to t("layout.footer.whatsapp"), whatsapp_url, target: "_blank", rel: "noopener" %>
        </p>
        <p class="footer-line">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <%# email_off: tells Cloudflare's Email Address Obfuscation to leave
              this address alone — otherwise it rewrites the link to
              /cdn-cgi/l/email-protection, a page crawlers then report. %>
          <!--email_off--><a href="mailto:hello@neuskin.sa" dir="ltr">hello@neuskin.sa</a><!--/email_off-->
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <span><%= t("layout.footer.copyright", year: Time.current.year) %></span>
      <nav class="footer-bottom-nav" aria-label="Legal">
        <%= link_to t("layout.footer.legal_privacy"), privacy_path %>
        <%= link_to t("layout.footer.legal_consent"), medical_disclaimer_path %>
        <%= link_to t("layout.footer.legal_terms"), terms_path %>
      </nav>
    </div>
  </div>
</footer>
