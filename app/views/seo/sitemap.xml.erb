<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @entries.each do |entry| %>
<% %i[en ar].each do |locale| %>
  <url>
    <loc><%= entry[locale] %></loc>
<% if entry[:lastmod] %>
    <lastmod><%= entry[:lastmod].to_date.iso8601 %></lastmod>
<% end %>
    <xhtml:link rel="alternate" hreflang="en" href="<%= entry[:en] %>"/>
    <xhtml:link rel="alternate" hreflang="ar" href="<%= entry[:ar] %>"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= entry[:en] %>"/>
  </url>
<% end %>
<% end %>
</urlset>
