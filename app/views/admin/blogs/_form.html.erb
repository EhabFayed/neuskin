<%= form_with model: @blog, url: @blog.persisted? ? admin_blog_path(@blog) : admin_blogs_path, local: true do |form| %>
  <% if @blog.errors.any? %>
    <div class="ns-flash" style="margin-bottom:16px">
      <% @blog.errors.full_messages.each do |msg| %><p style="margin:2px 0"><%= msg %></p><% end %>
    </div>
  <% end %>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Title</span>
    <div class="ns-pair">
      <div class="en">
        <span class="lang-lbl">English</span>
        <%= form.text_field :title_en, class: "ns-input" %>
      </div>
      <div class="ar">
        <span class="lang-lbl">العربية · Arabic</span>
        <%= form.text_field :title_ar, dir: "rtl", class: "ns-input" %>
      </div>
    </div>
  </div>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Excerpt <span class="hint">— the card text on the Journal grid</span></span>
    <div class="ns-pair">
      <div class="en">
        <span class="lang-lbl">English</span>
        <%= form.text_area :excerpt_en, rows: 3, class: "ns-textarea" %>
      </div>
      <div class="ar">
        <span class="lang-lbl">العربية · Arabic</span>
        <%= form.text_area :excerpt_ar, rows: 3, dir: "rtl", class: "ns-textarea" %>
      </div>
    </div>
  </div>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Body paragraphs</span>
    <p class="hint">One card per paragraph, in reading order. Leave both languages blank to drop a row.</p>
    <div id="blog-paragraphs">
      <%= form.fields_for :contents do |cf| %>
        <div class="ns-card" style="margin:10px 0;background:var(--ns-bg)">
          <%= cf.hidden_field :id %>
          <%= cf.hidden_field :key %>
          <%= cf.hidden_field :position %>
          <div class="ns-pair">
            <div class="en">
              <span class="lang-lbl">English</span>
              <div data-rte>
                <%= cf.hidden_field :value_en %>
                <div class="rte-editor"><%= rich(cf.object.value_en) %></div>
              </div>
            </div>
            <div class="ar">
              <span class="lang-lbl">العربية · Arabic</span>
              <div data-rte data-dir="rtl">
                <%= cf.hidden_field :value_ar %>
                <div class="rte-editor" dir="rtl"><%= rich(cf.object.value_ar) %></div>
              </div>
            </div>
          </div>
          <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--ns-border-soft)">
            <span class="lang-lbl" style="display:block;margin-bottom:8px">Paragraph image (optional) — one per language</span>
            <div class="ns-pair ns-imgpair">
              <div class="en">
                <span class="lang-lbl">English</span>
                <%= render "admin/shared/image_field", name: "#{cf.object_name}[photo]", current: cf.object.photo,
                           remove_name: "#{cf.object_name}[remove_photo]", size: "sm",
                           hint: "Shown under this paragraph in the English article." %>
              </div>
              <div class="ar">
                <span class="lang-lbl">العربية · Arabic</span>
                <%= render "admin/shared/image_field", name: "#{cf.object_name}[photo_ar]", current: cf.object.photo_ar,
                           remove_name: "#{cf.object_name}[remove_photo_ar]", size: "sm",
                           hint: "Optional. Left empty, the Arabic article shows the English image." %>
              </div>
            </div>
            <div class="ns-pair" style="margin-top:8px">
              <div class="en">
                <span class="lang-lbl">Image alt · English</span>
                <%= cf.text_field :alt_en, class: "ns-input" %>
              </div>
              <div class="ar">
                <span class="lang-lbl">النص البديل · Arabic</span>
                <%= cf.text_field :alt_ar, dir: "rtl", class: "ns-input" %>
              </div>
            </div>
          </div>
          <% if cf.object.persisted? %>
            <label style="display:inline-flex;align-items:center;gap:6px;margin-top:8px;font-size:12px;color:var(--ns-muted)">
              <%= cf.check_box :_destroy %> Remove this paragraph
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
    <template id="blog-paragraph-template">
      <div class="ns-card" style="margin:10px 0;background:var(--ns-bg)">
        <input type="hidden" name="blog[contents_attributes][IDX][position]">
        <div class="ns-pair">
          <div class="en">
            <span class="lang-lbl">English</span>
            <div data-rte>
              <input type="hidden" name="blog[contents_attributes][IDX][value_en]">
              <div class="rte-editor"></div>
            </div>
          </div>
          <div class="ar">
            <span class="lang-lbl">العربية · Arabic</span>
            <div data-rte data-dir="rtl">
              <input type="hidden" name="blog[contents_attributes][IDX][value_ar]">
              <div class="rte-editor" dir="rtl"></div>
            </div>
          </div>
        </div>
        <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--ns-border-soft)">
          <span class="lang-lbl" style="display:block;margin-bottom:8px">Paragraph image (optional) — one per language</span>
          <div class="ns-pair ns-imgpair">
            <div class="en">
              <span class="lang-lbl">English</span>
              <%= render "admin/shared/image_field", name: "blog[contents_attributes][IDX][photo]", current: nil,
                         remove_name: "blog[contents_attributes][IDX][remove_photo]", size: "sm" %>
            </div>
            <div class="ar">
              <span class="lang-lbl">العربية · Arabic</span>
              <%= render "admin/shared/image_field", name: "blog[contents_attributes][IDX][photo_ar]", current: nil,
                         remove_name: "blog[contents_attributes][IDX][remove_photo_ar]", size: "sm",
                         hint: "Optional. Left empty, the Arabic article shows the English image." %>
            </div>
          </div>
          <div class="ns-pair" style="margin-top:8px">
            <div class="en">
              <span class="lang-lbl">Image alt · English</span>
              <input type="text" name="blog[contents_attributes][IDX][alt_en]" class="ns-input">
            </div>
            <div class="ar">
              <span class="lang-lbl">النص البديل · Arabic</span>
              <input type="text" name="blog[contents_attributes][IDX][alt_ar]" dir="rtl" class="ns-input">
            </div>
          </div>
        </div>
      </div>
    </template>
    <button type="button" class="ns-btn ghost" style="margin-top:6px"
            onclick="var t=document.getElementById('blog-paragraph-template'),w=document.getElementById('blog-paragraphs'),i=Date.now();w.insertAdjacentHTML('beforeend',t.innerHTML.replaceAll('IDX',i));">
      + Add paragraph
    </button>
  </div>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Cover image — one per language</span>
    <p class="hint" style="margin:0 0 12px">The card on the Journal grid and the article hero.</p>
    <div class="ns-pair ns-imgpair">
      <div class="en">
        <span class="lang-lbl">English</span>
        <%= render "admin/shared/image_field", name: "blog[image]", current: @blog.image, remove_name: "blog[remove_image]",
                   hint: "Without one, a rotating stock cover is used." %>
      </div>
      <div class="ar">
        <span class="lang-lbl">العربية · Arabic</span>
        <%= render "admin/shared/image_field", name: "blog[image_ar]", current: @blog.image_ar, remove_name: "blog[remove_image_ar]",
                   hint: "Optional. Left empty, the Arabic article shows the English cover." %>
      </div>
    </div>
    <div class="ns-pair" style="margin-top:10px">
      <div class="en">
        <span class="lang-lbl">Alt text · English</span>
        <%= form.text_field :alt_en, class: "ns-input" %>
      </div>
      <div class="ar">
        <span class="lang-lbl">النص البديل · Arabic</span>
        <%= form.text_field :alt_ar, dir: "rtl", class: "ns-input" %>
      </div>
    </div>
  </div>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Settings</span>
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-end">
      <label style="display:block">
        <span class="lang-lbl">Category</span><br>
        <%= form.select :category, Blog.category.values.map { |v| [I18n.t("journal.categories.#{v}", locale: :en), v] }, {}, class: "ns-input" %>
      </label>
      <label style="display:block">
        <span class="lang-lbl">Slug · English URL</span><br>
        <%= form.text_field :slug_en, class: "ns-input", placeholder: "auto from English title" %>
      </label>
      <label style="display:block">
        <span class="lang-lbl">Slug · Arabic URL</span><br>
        <%= form.text_field :slug_ar, dir: "rtl", class: "ns-input", placeholder: "تلقائي من العنوان العربي" %>
      </label>
      <label style="display:inline-flex;align-items:center;gap:8px;padding-bottom:10px">
        <%= form.check_box :is_published %> Published
      </label>
    </div>
  </div>

  <div class="ns-card" style="margin-bottom:14px">
    <span class="ns-field-title">Frequently asked <span class="hint">(optional)</span></span>
    <p class="hint">Short Q&amp;A shown under the article as an accordion (and as FAQ schema for search engines). Leave every field blank to drop a row.</p>
    <%# Rows post as blog[faqs][][q_en] etc. — an array of hashes the controller
        normalises (blank rows dropped). The marker tells the controller the
        list was submitted, so removing every row clears it. %>
    <input type="hidden" name="blog[faqs_submitted]" value="1">
    <div id="blog-faqs">
      <% Array(@blog.faqs).each do |faq| %>
        <div class="ns-card blog-faq-row" style="margin:10px 0;background:var(--ns-bg)">
          <div class="ns-pair">
            <div class="en">
              <span class="lang-lbl">Question · English</span>
              <input type="text" name="blog[faqs][][q_en]" class="ns-input" value="<%= faq["q_en"] %>">
              <span class="lang-lbl" style="margin-top:8px;display:block">Answer · English</span>
              <textarea name="blog[faqs][][a_en]" rows="3" class="ns-textarea"><%= faq["a_en"] %></textarea>
            </div>
            <div class="ar">
              <span class="lang-lbl">السؤال · Arabic</span>
              <input type="text" name="blog[faqs][][q_ar]" dir="rtl" class="ns-input" value="<%= faq["q_ar"] %>">
              <span class="lang-lbl" style="margin-top:8px;display:block">الإجابة · Arabic</span>
              <textarea name="blog[faqs][][a_ar]" rows="3" dir="rtl" class="ns-textarea"><%= faq["a_ar"] %></textarea>
            </div>
          </div>
          <button type="button" class="ns-btn ghost" style="margin-top:8px;font-size:12px"
                  onclick="this.closest('.blog-faq-row').remove()">Remove question</button>
        </div>
      <% end %>
    </div>
    <template id="blog-faq-template">
      <div class="ns-card blog-faq-row" style="margin:10px 0;background:var(--ns-bg)">
        <div class="ns-pair">
          <div class="en">
            <span class="lang-lbl">Question · English</span>
            <input type="text" name="blog[faqs][][q_en]" class="ns-input">
            <span class="lang-lbl" style="margin-top:8px;display:block">Answer · English</span>
            <textarea name="blog[faqs][][a_en]" rows="3" class="ns-textarea"></textarea>
          </div>
          <div class="ar">
            <span class="lang-lbl">السؤال · Arabic</span>
            <input type="text" name="blog[faqs][][q_ar]" dir="rtl" class="ns-input">
            <span class="lang-lbl" style="margin-top:8px;display:block">الإجابة · Arabic</span>
            <textarea name="blog[faqs][][a_ar]" rows="3" dir="rtl" class="ns-textarea"></textarea>
          </div>
        </div>
        <button type="button" class="ns-btn ghost" style="margin-top:8px;font-size:12px"
                onclick="this.closest('.blog-faq-row').remove()">Remove question</button>
      </div>
    </template>
    <button type="button" class="ns-btn ghost" style="margin-top:6px"
            onclick="var t=document.getElementById('blog-faq-template'),w=document.getElementById('blog-faqs');w.insertAdjacentHTML('beforeend',t.innerHTML);">
      + Add question
    </button>
  </div>

  <details class="ns-card" style="margin-bottom:14px">
    <summary class="ns-field-title" style="cursor:pointer">SEO (optional)</summary>
    <div class="ns-pair" style="margin-top:10px">
      <div class="en">
        <span class="lang-lbl">Meta title · English</span>
        <%= form.text_field :meta_title_en, class: "ns-input" %>
        <span class="lang-lbl" style="margin-top:8px;display:block">Meta description · English</span>
        <%= form.text_area :meta_description_en, rows: 2, class: "ns-textarea" %>
      </div>
      <div class="ar">
        <span class="lang-lbl">Meta title · Arabic</span>
        <%= form.text_field :meta_title_ar, dir: "rtl", class: "ns-input" %>
        <span class="lang-lbl" style="margin-top:8px;display:block">Meta description · Arabic</span>
        <%= form.text_area :meta_description_ar, rows: 2, dir: "rtl", class: "ns-textarea" %>
      </div>
    </div>
  </details>

  <div class="ns-savebar">
    <%= link_to "Back to posts", admin_blogs_path, class: "ns-btn ghost" %>
    <% if @blog.persisted? %>
      <a href="<%= journal_article_path(@blog) %>" target="_blank" rel="noopener" class="ns-btn ghost">View post</a>
    <% end %>
    <span class="spacer"></span>
    <% if @blog.persisted? %>
      <%= link_to "Delete post", admin_blog_path(@blog), class: "ns-btn danger",
                  data: { turbo_method: :delete, turbo_confirm: "Delete “#{@blog.title_en}” permanently?" } %>
    <% end %>
    <%= form.submit "Save", class: "ns-btn primary" %>
  </div>
<% end %>
