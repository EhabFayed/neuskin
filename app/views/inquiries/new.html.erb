<%# Contact & Inquiry (design §isContact) — two-path layout + private form.
    Fully localized (inquire.* keys). The form itself is shared/_inquiry_form. %>
<% content_for :title, "#{t('inquire.form.meta_title')} — NeuSkin Clinic" %>
<%# Links from protocol pages carry ?codeword=&persona= so the form is
    prefilled. Those variants must not be indexed as separate pages: the
    canonical already points at the bare /inquire URL, and any query-string
    variant is marked noindex,follow. %>
<% content_for :head_extra, tag.meta(name: "robots", content: "noindex, follow") if request.query_parameters.any? %>

<section class="page-hero" data-controller="reveal" style="text-align:center">
  <span class="eyebrow center reveal" data-reveal-target="item"><%= t("inquire.hero_eyebrow") %></span>
  <h1 style="margin-inline:auto">
    <span data-reveal="mask" data-reveal-delay="120"><span><%= t("inquire.hero_title_1") %></span></span>
    <span class="em" data-reveal="mask" data-reveal-delay="240"><span><%= t("inquire.hero_title_em") %></span></span>
  </h1>
</section>

<section class="section section--surface" data-controller="reveal">
  <div class="section-inner">
    <div class="paths">

      <%# Path A — WhatsApp %>
      <div class="path reveal" data-reveal-target="item">
        <span class="ptag"><%= t("inquire.path_a_tag") %></span>
        <h3><%= t("inquire.path_a_title") %></h3>
        <p><%= t("inquire.path_a_body") %></p>
        <a class="btn" href="<%= whatsapp_url(codeword: @inquiry.source_codeword) %>" target="_blank" rel="noopener">
          <%= t("inquire.path_a_button") %>
        </a>
        <p class="path-phone">+966 11 266 9992</p>
      </div>

      <%# Path B — private form %>
      <div class="path reveal d1" data-reveal-target="item">
        <span class="ptag"><%= t("inquire.path_b_tag") %></span>
        <%= render "shared/inquiry_form", inquiry: @inquiry, compact: false %>
      </div>

    </div>
  </div>
</section>

<%# Trust strip %>
<section class="section" data-controller="reveal">
  <div class="section-inner">
    <div class="trust">
      <% %w[reply place seen].each_with_index do |key, i| %>
        <div class="reveal<%= " d#{i}" if i > 0 %>" data-reveal-target="item">
          <h4><%= t("inquire.trust.#{key}.title") %></h4>
          <p><%= t("inquire.trust.#{key}.body") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
