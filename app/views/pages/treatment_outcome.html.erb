<%# Treatment outcome — NeuSkin Clinic (standalone) design port. English / LTR.
    One template, one Treatment record per outcome — copy and image are fully
    managed in the dashboard (Admin → Treatments). %>
<%# Search snippet: the record's own meta fields (Admin → Treatments → Search
    preview), else built from the headline + "what it looks like". %>
<% content_for :title, @treatment.meta_title.presence || "#{@treatment.headline} — #{t('seo.site_name')}" %>
<% content_for :meta_description, @treatment.meta_description.presence || @treatment.block("hero_intro").presence || @treatment.look.presence || @treatment.how %>

<% if @treatment.detail_blocks? %>
<%# ================= Client content PDF (Nov 2026) — dashboard-editable
    sections (Admin → Treatments → Page sections). Hero photo beside the copy,
    four question sections, CTA bands and a FAQ. ================= %>
<%= render "pages/detail/hero",
      image: image_tag(treatment_image_url(@treatment, width: 1800), alt: @treatment.headline, fetchpriority: "high", decoding: "async"),
      eyebrow: nil,
      title: @treatment.block("hero_title").presence || @treatment.headline,
      intro: @treatment.block("hero_intro").presence || @treatment.look,
      cta_label: @treatment.block("hero_cta") %>
<%= render "pages/detail/section", title: @treatment.block("s1_title"), intro: @treatment.block("s1_intro"), items: @treatment.block_items("s1_items"), outro: @treatment.block("s1_outro"), style: :points, tone: "surface" %>
<%= render "pages/detail/section", title: @treatment.block("s2_title"), intro: @treatment.block("s2_intro"), items: @treatment.block_items("s2_items"), outro: @treatment.block("s2_outro"), style: :steps, tone: "light" %>
<%= render "pages/detail/section", title: @treatment.block("s3_title"), intro: @treatment.block("s3_intro"), items: @treatment.block_items("s3_items"), outro: @treatment.block("s3_outro"), style: :points, tone: "surface" %>
<%= render "pages/detail/cta" %>
<%= render "pages/detail/section", title: @treatment.block("s4_title"), intro: @treatment.block("s4_intro"), items: @treatment.block_items("s4_items"), outro: @treatment.block("s4_outro"), style: :points, tone: "light" %>
<%= render "pages/detail/faq", faqs: @treatment.detail_faqs %>
<%= render "pages/detail/cta" %>
<% else %>
<%# ---- 1 · Full-bleed hero, text bottom-left (design 72vh) ---- %>
<section class="over-hero over-hero--outcome" data-controller="reveal parallax">
  <div class="over-hero-media" data-parallax data-parallax-speed="0.08">
    <%= image_tag treatment_image_url(@treatment, width: 1800), alt: @treatment.headline, class: "kb", fetchpriority: "high" %>
  </div>
  <div class="over-hero-copy over-hero-copy--wide">
    <div class="clinic-hero-eyebrow reveal" data-reveal-target="item"><%= @treatment.title %></div>
    <h1 class="clinic-hero-title" data-reveal="up"><%= @treatment.headline %></h1>
  </div>
</section>

<%# ---- 2 · What it looks like / how NeuSkin treats it ---- %>
<section class="section section--surface" data-controller="reveal">
  <div class="section-inner split">
    <div class="split-text reveal" data-reveal-target="item">
      <span class="eyebrow"><%= t("treatments.look_eyebrow", default: "What it looks like") %></span>
      <p class="lead"><%= @treatment.look %></p>
    </div>
    <div class="split-text reveal d1" data-reveal-target="item">
      <span class="eyebrow"><%= t("treatments.how_eyebrow", default: "How NeuSkin treats it") %></span>
      <p><%= @treatment.how %></p>
    </div>
  </div>
</section>

<%# ---- 3 · The protocol that owns this (light band) ---- %>
<% if @protocol %>
  <section class="section section--light" data-controller="reveal">
    <div class="section-inner" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:30px">
      <div class="reveal" data-reveal-target="item">
        <span class="eyebrow"><%= t("treatments.owner_eyebrow", default: "The protocol that owns this") %></span>
        <h2 style="margin:14px 0 0"><%= @protocol.name %><% if @protocol.trademark %><span class="tm">™</span><% end %></h2>
      </div>
      <%= link_to t("treatment_page.view_protocol"), protocol_path(@protocol),
                  class: "btn btn--rose reveal d1", data: { reveal_target: "item" } %>
    </div>
  </section>
<% end %>

<%# ---- 4 · The NeuSkin view + closing CTA ---- %>
<% if @treatment.view.present? %>
  <section class="pull-band orn-host" data-controller="reveal">
    <%= render "shared/orn", variant: "petal", pos: "tl", size: 220 %>
    <span class="eyebrow center no-rule reveal" data-reveal-target="item" style="margin-block-end:34px"><%= t("treatment_page.neuskin_view") %></span>
    <blockquote class="reveal d1" data-reveal-target="item">“<%= @treatment.view %>”</blockquote>
    <p class="by reveal d2" data-reveal-target="item">— NeuSkin</p>
    <p class="reveal d3" data-reveal-target="item" style="margin-block-start:50px">
      <%= link_to t("treatment_page.private_inquiry"), inquire_path, class: "btn btn--ghost" %>
    </p>
  </section>
<% end %>
<% end %>
