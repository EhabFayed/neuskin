<%# Legal & Compliance (design §15) — one template, THREE distinct documents:
    privacy / medical_disclaimer / terms (the `doc` local). Each URL renders
    only its own copy — the document's sections from config/locales
    (legal.<doc>) plus the dashboard-editable summary for that document
    (Pages → Legal → Legal sections: <doc>_p1 opens, <doc>_p2 closes) — so the
    three pages no longer share one body (duplicate-content audit finding).
    The other two documents are linked at the foot. %>
<% suffix   = ar? ? "ar" : "en" %>
<% cms_key  = { "privacy" => "privacy", "medical_disclaimer" => "medical", "terms" => "terms" }.fetch(doc) %>
<% title    = t("legal.#{doc}.title_#{suffix}") %>
<% sections = Array(t("legal.#{doc}.sections", default: [])) %>
<% lead     = sec_text("legal", "legal_blocks", "#{cms_key}_p1").presence || sections.first&.dig(:"body_#{suffix}") %>
<% closing  = sec_text("legal", "legal_blocks", "#{cms_key}_p2") %>
<% related  = { "privacy" => privacy_path, "medical_disclaimer" => medical_disclaimer_path, "terms" => terms_path }.except(doc) %>

<section class="page-hero" data-controller="reveal">
  <span class="eyebrow reveal" data-reveal-target="item"><%= sec_text("legal", "legal_hero", "eyebrow").presence || t("legal.eyebrow") %></span>
  <h1><span data-reveal="mask" data-reveal-delay="120"><span><%= title %></span></span></h1>
  <% if lead.present? %>
    <p class="lead reveal d2" data-reveal-target="item"><%= lead %></p>
  <% end %>
</section>

<section class="section" data-controller="reveal">
  <div class="section-inner">

    <% sections.each_with_index do |s, i| %>
      <div class="legal-block reveal<%= " d#{[ i, 4 ].min}" if i.positive? %>" data-reveal-target="item">
        <h2><%= s[:"heading_#{suffix}"] %></h2>
        <p><%= s[:"body_#{suffix}"] %></p>
      </div>
    <% end %>

    <% if doc == "privacy" %>
      <%# Consent policy belongs with personal data (photos, patient material). %>
      <div class="legal-block reveal d4" data-reveal-target="item">
        <h2><%= sec_text("legal", "legal_blocks", "consent_title").presence || loc(ar: "سياسة الموافقة", en: "Consent policy") %></h2>
        <p>
          <%= sec_text("legal", "legal_blocks", "consent_p1").presence || loc(
                ar: "يتطلّب التصوير واستخدام أي مادة تخصّ المريضة موافقةً كتابيةً منفصلةً ومحدّدة. لا تُفترض الموافقة أبدًا، وتُمنح بحرّية، ويمكن سحبها في أي وقت دون أن يؤثّر ذلك على رعايتك.",
                en: "Photography and the use of any patient material require separate, specific, written consent. Consent is never assumed, is given freely, and may be withdrawn at any time without affecting your care.") %>
        </p>
      </div>
    <% end %>

    <% if closing.present? %>
      <div class="legal-block reveal d4" data-reveal-target="item">
        <p><%= closing %></p>
      </div>
    <% end %>

    <div class="legal-block reveal d4" data-reveal-target="item">
      <p><%= t("legal.contact_#{suffix}") %></p>
    </div>

    <div class="license-line reveal d4" data-reveal-target="item">
      <span><%= sec_text("legal", "legal_license", "label").presence || "SFDA / MOH license" %></span>
      <span><%= sec_text("legal", "legal_license", "number").presence || "No. 0000000000" %></span>
    </div>

    <nav class="legal-related reveal d4" data-reveal-target="item" aria-label="<%= t("seo.legal_related_aria") %>">
      <span class="lbl"><%= t("seo.legal_related") %></span>
      <% related.each do |other_doc, path| %>
        <%= link_to t("legal.#{other_doc}.title_#{suffix}"), path %>
      <% end %>
    </nav>

  </div>
</section>
