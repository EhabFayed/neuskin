<%# The Clinic — NeuSkin Clinic (standalone) design port. English / LTR. %>

<%# ---- Full-bleed hero, text overlaid (1:1 port of design §isClinic) ---- %>
<section class="over-hero over-hero--clinic" data-controller="reveal parallax">
  <div class="over-hero-media" data-parallax data-parallax-speed="0.08">
    <%= sec_image_tag("the_clinic", "clinic_hero", :clinic_hero, alt: "NeuSkin interior", class: "kb") %>
  </div>
  <div class="over-hero-copy over-hero-copy--wide">
    <div class="clinic-hero-eyebrow reveal" data-reveal-target="item"><%= sec_text("the_clinic", "clinic_hero", "eyebrow").presence || "About · The Clinic" %></div>
    <h1 class="clinic-hero-title" data-reveal="up"><%= sec_text("the_clinic", "clinic_hero", "title_1").presence || "A private clinic in Al Malqa, built around one question:" %> <span class="em"><%= sec_text("the_clinic", "clinic_hero", "title_em").presence || "what will your skin look like in five years?" %></span></h1>
  </div>
</section>

<%# ---- Philosophy — photo + numbered points ----
    Client audit (Oct 2026): the big "measured by what it refuses to do"
    statement is gone; the photo sits on its own and the copy next to it is a
    numbered list. Texts stay CMS-editable (clinic_philosophy body_1..3, sign);
    the old statement_* keys are no longer rendered. %>
<section class="section section--surface" data-controller="reveal">
  <div class="section-inner split media-left">
    <div class="split-media reveal" data-reveal-target="item">
      <%= sec_image_tag("the_clinic", "clinic_philosophy", :clinic_shot_2, alt: "Inside the NeuSkin clinic", loading: "lazy") %>
    </div>
    <div class="split-text reveal d1" data-reveal-target="item">
      <% point_defaults = ["NeuSkin began with a frustration: skin care in Riyadh had become a list of treatments and a public price grid, sold the way a menu is sold. We wanted the opposite — a quiet room, a doctor who looks properly, and a plan written for one person at a time.",
                           "So we built a clinic around diagnosis, not display. Every patient begins with the NeuSkin Method™ — a full reading of skin, hair and body — before anything is recommended, let alone performed. We chose Al Malqa for its discretion, and we chose women as our focus because they have been sold to longest, and listened to least.",
                           "We are not the loudest clinic in the city. We intend to be the one you keep."] %>
      <ol class="clinic-points">
        <% point_defaults.each_with_index do |fallback, idx| %>
          <li data-reveal="up" data-reveal-delay="<%= 160 + idx * 90 %>"><%= sec_text("the_clinic", "clinic_philosophy", "body_#{idx + 1}").presence || fallback %></li>
        <% end %>
      </ol>
      <p class="sign" data-reveal="up" data-reveal-delay="440" style="margin-top:32px"><%= sec_text("the_clinic", "clinic_philosophy", "sign").presence || "— The NeuSkin Team" %></p>
    </div>
  </div>
</section>

<%# ---- The Space — moving photo gallery ----
    Client audit (Oct 2026): the label is the section h2 and the photos glide
    across in a seamless loop (pauses on hover, reverses for RTL, static under
    reduced motion). Every image attached to the clinic_space gallery in the
    dashboard is shown, in order, so editors can keep adding photos. Every
    photo carries its own caption (SectionPhoto), hidden until the viewer
    taps the photo's "i" button. Falls back to the five launch shots when
    nothing is attached. %>
<section class="section section--surface" data-controller="reveal">
  <div class="section-inner">
    <h2 class="sec-title-md reveal" data-reveal-target="item"><%= sec_text("the_clinic", "clinic_space", "eyebrow").presence || "The Space" %></h2>
  </div>
  <% clinic_space_photos = sec_photos("the_clinic", "clinic_space",
                                      [:clinic_shot_1, :clinic_shot_2, :clinic_shot_3, :clinic_shot_4, :clinic_shot_5],
                                      ["The lounge", "In the detail", "Device room", "Treatment room", "The entrance"], width: 1000) %>
  <% cap_label = I18n.locale == :ar ? "عرض التعليق" : "Show caption" %>
  <div class="photo-marquee reveal d1" data-reveal-target="item" style="margin-top:var(--space-block)">
    <div class="photo-marquee-track">
      <% 2.times do |copy| %>
        <div class="photo-marquee-seg"<%= ' aria-hidden="true"'.html_safe if copy == 1 %>>
          <% clinic_space_photos.each do |photo| %>
            <% caption = photo.caption.to_s %>
            <figure class="shot pm-shot"<%= ' data-controller="shotcap"'.html_safe if caption.present? %>>
              <%= image_tag photo.url, alt: caption, loading: "lazy", decoding: "async" %>
              <% if caption.present? %>
                <button type="button" class="pm-cap-btn" aria-expanded="false" aria-label="<%= cap_label %>"
                        data-action="shotcap#toggle" data-shotcap-target="button"<%= ' tabindex="-1"'.html_safe if copy == 1 %>>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
                </button>
                <figcaption class="pm-cap"><%= caption %></figcaption>
              <% end %>
            </figure>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Four-step patient journey (light contrast band) ---- %>
<section class="section section--light orn-host" data-controller="reveal">
  <%= render "shared/orn", variant: "dots", pos: "tr" %>
  <div class="section-inner">
    <div class="reveal" data-reveal-target="item">
      <div class="journey-eyebrow"><%= sec_text("the_clinic", "clinic_journey", "eyebrow").presence || "How we work" %></div>
      <h2 class="journey-title"><%= sec_text("the_clinic", "clinic_journey", "title").presence || "The four-step patient journey" %></h2>
    </div>
    <%# Expanding panel gallery: steps side by side; the active step is wide
        with its copy shown and image zoomed — hovering a neighbour hands the
        expansion over. Texts and per-card images stay dashboard-editable. %>
    <% journey_defaults = ["site/space/waiting-lounge.webp", "site/space/consultation.webp",
                           "site/space/clinic-1.webp", "site/space/treatment.webp"] %>
    <% journey_steps = [["Inquire", "A private WhatsApp message or form, reviewed personally by our patient relations lead."],
                        ["Consult", "A 60-minute NeuSkin Method™ assessment. Doctor-led, diagnostic. No treatment performed."],
                        ["Plan",    "A written 12-month roadmap — skin, hair, body, lifestyle. Yours to keep, whatever you decide."],
                        ["Treat",   "Sequenced sessions with quarterly review, adjusted as your skin responds."]] %>
    <div class="ns-expand reveal d1" data-reveal-target="item">
      <% journey_steps.each_with_index do |(title_default, body_default), idx| %>
        <% i = idx + 1 %>
        <div class="ns-panel">
          <img src="<%= sec_card_image("the_clinic", "clinic_journey", i, journey_defaults[idx]) %>" alt="">
          <div class="ns-panel-copy">
            <span class="num"><%= sec_text("the_clinic", "clinic_journey", "step_#{i}_n").presence || format("%02d", i) %> — <%= t("treatments.step", default: "Step") %></span>
            <h3><%= sec_text("the_clinic", "clinic_journey", "step_#{i}_title").presence || title_default %></h3>
            <p><%= sec_text("the_clinic", "clinic_journey", "step_#{i}_body").presence || body_default %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Credentials, in plain language ---- %>
<%# Hidden July 2026 per content team; flip `false` to true to restore. The
    "clinic_credentials" section stays editable in the dashboard meanwhile. %>
<% if false %>
<section class="section section--surface" data-controller="reveal">
  <div class="section-inner split">
    <div class="split-text reveal" data-reveal-target="item">
      <span class="eyebrow"><%= sec_text("the_clinic", "clinic_credentials", "eyebrow").presence || "The standard" %></span>
      <h2 style="margin-top:22px"><%= sec_text("the_clinic", "clinic_credentials", "title").presence || "Credentials, in plain language." %></h2>
      <div class="body-copy">
        <p><%= sec_text("the_clinic", "clinic_credentials", "body_1").presence || "We keep our compliance visible because trust should not be a leap of faith. Our licenses, our consent policy, and our honest limits are stated plainly — here, not buried." %></p>
      </div>
    </div>
    <div class="split-text reveal d1" data-reveal-target="item">
      <ul class="specs">
        <li><span class="k"><%= sec_text("the_clinic", "clinic_credentials", "spec_1_k").presence || "SFDA / MOH license" %></span><span class="v"><%= sec_text("the_clinic", "clinic_credentials", "spec_1_v").presence || "No. 0000000000" %></span></li>
        <li><span class="k"><%= sec_text("the_clinic", "clinic_credentials", "spec_2_k").presence || "Practitioner licenses" %></span><span class="v"><%= sec_text("the_clinic", "clinic_credentials", "spec_2_v").presence || "On file · verifiable" %></span></li>
        <li><span class="k"><%= sec_text("the_clinic", "clinic_credentials", "spec_3_k").presence || "Patient privacy" %></span><span class="v"><%= sec_text("the_clinic", "clinic_credentials", "spec_3_v").presence || "PDPL compliant" %></span></li>
        <li><span class="k"><%= sec_text("the_clinic", "clinic_credentials", "spec_4_k").presence || "Photographic consent" %></span><span class="v"><%= sec_text("the_clinic", "clinic_credentials", "spec_4_v").presence || "Explicit · withdrawable" %></span></li>
      </ul>
      <div class="body-copy" style="margin-top:24px">
        <p><%= sec_text("the_clinic", "clinic_credentials", "body_2").presence || "Results vary. Everything we do is subject to medical consultation and individual assessment — and we would rather tell you \"no\" than sell you a \"yes\"." %></p>
      </div>
    </div>
  </div>
</section>
<% end %>

<%# ---- Closing CTA ---- %>
<section class="section" data-controller="reveal">
  <div class="section-inner">
    <div class="cta-center orn-host reveal" data-reveal-target="item">
      <%= render "shared/orn", variant: "rings", pos: "halo", size: 380 %>
      <h2><%= sec_text("the_clinic", "clinic_cta", "title").presence || "Begin a quiet conversation." %></h2>
      <p><%= sec_text("the_clinic", "clinic_cta", "body").presence || "We reply, personally, Saturday to Thursday, 10:00–22:00." %></p>
      <%= link_to (sec_text("the_clinic", "clinic_cta", "cta_label").presence || "Speak with us"), inquire_path, class: "btn" %>
    </div>
  </div>
</section>
