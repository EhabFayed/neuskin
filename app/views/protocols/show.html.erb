<%# Protocol detail — NeuSkin Clinic (standalone) design port. English / LTR. %>
<% p = @protocol %>
<%# Search snippet: the record's own meta fields (Admin → Protocols → Search
    preview), else built from the name + promise. %>
<% content_for :title, p.meta_title.presence || "#{p.name} — #{t('seo.site_name')}" %>
<% content_for :meta_description, p.meta_description.presence || p.promise.presence || p.who_for %>

<%# Shared copy on every protocol page (Pages → "Protocol page (shared copy)",
    section protocol/template); the locale string is the fallback. %>
<% shared = ->(key) { sec_text("protocol", "template", key).presence || t("protocol_page.#{key}") } %>

<%# Hero image = the protocol's dashboard image (Admin → Protocols), launch
    static asset as fallback — see protocol_image_url. %>
<% for_who = p.who_for.to_s.split(/[.\n]/).first.to_s.strip.presence || t("protocol_page.by_assessment") %>

<%# 1 · Split hero ---- %>
<section class="split-hero" data-controller="reveal parallax">
  <div class="split-hero-media reveal" data-reveal-target="item" data-parallax data-parallax-speed="0.08">
    <%= image_tag protocol_image_url(p, width: 1600), alt: p.name, class: "kb", fetchpriority: "high" %>
  </div>
  <div class="split-hero-copy">
    <span class="eyebrow reveal" data-reveal-target="item"><%= p.meta %></span>
    <h1><span data-reveal="mask" data-reveal-delay="120"><span><bdi><%= p.name %><% if p.trademark %><span class="tm">™</span><% end %></bdi></span></span></h1>
    <p class="lead reveal d2" data-reveal-target="item"><%= p.promise %></p>
    <%# Rows under the title: the protocol's own list (Admin → Protocols →
        "Hero rows"), or the original three when the list is empty. %>
    <% hero_rows = p.specs_for_locale %>
    <ul class="specs reveal d3" data-reveal-target="item">
      <% if hero_rows.any? %>
        <% hero_rows.each do |label, value| %>
          <li><span class="k"><%= label %></span><span class="v"><%= value %></span></li>
        <% end %>
      <% else %>
        <li><span class="k"><%= t("protocol_page.duration") %></span><span class="v"><%= p.duration %></span></li>
        <li><span class="k"><%= t("protocol_page.format") %></span><span class="v"><%= shared.(:format_value) %></span></li>
        <li><span class="k"><%= t("protocol_page.for") %></span><span class="v"><%= for_who %></span></li>
      <% end %>
    </ul>
    <p class="reveal d4" data-reveal-target="item"><%= link_to t("protocol_page.request_plan"), inquire_path(codeword: p.codeword, persona: p.persona), class: "btn" %></p>
  </div>
</section>

<%# 2 · Who it's for ---- %>
<% signs = p.signs.each_with_index.map { |line, i| [format("%02d", i + 1), line] } %>
<section class="section section--surface proto-detail" data-controller="reveal">
  <div class="section-inner split">
    <div class="split-text reveal" data-reveal-target="item">
      <span class="eyebrow"><%= t("protocol_page.who_for") %></span>
      <%# h2 for the document outline / SEO; styled as the lead paragraph. %>
      <h2 class="lead"><%= p.who_for %></h2>
    </div>
    <div class="split-text">
      <ul class="rows">
        <% signs.each_with_index do |(n, t), i| %>
          <li data-reveal="left" data-reveal-delay="<%= 120 + i * 140 %>"><span class="n"><%= n %></span><span class="t"><%= t %></span></li>
        <% end %>
      </ul>
      <p class="sign" style="font-style:italic;margin-top:24px" data-reveal="fade" data-reveal-delay="<%= 120 + signs.size * 140 %>"><%= shared.(:not_for_all) %></p>
    </div>
  </div>
</section>

<%# 3 · What's inside (staged timeline) ---- %>
<section class="section proto-detail" data-controller="reveal">
  <div class="section-inner">
    <div class="sec-head">
      <span class="eyebrow" data-reveal="fade"><%= t("protocol_page.inside") %></span>
      <h2 data-reveal="mask" data-reveal-delay="120"><span><%= p.scope %></span></h2>
    </div>
    <% if p.stages.any? %>
    <div class="stages">
      <% p.stages.each_with_index do |stage, i| %>
        <div class="stage" data-reveal="up" data-reveal-delay="<%= 160 + i * 150 %>">
          <span class="wk"><%= p.loc(stage, "week") %></span>
          <h3><%= p.loc(stage, "title") %></h3>
          <p><%= p.loc(stage, "body") %></p>
        </div>
      <% end %>
    </div>
    <% end %>
    <p class="note" data-reveal="fade" data-reveal-delay="<%= 160 + p.stages.size * 150 %>" style="margin-top:46px"><%= shared.(:scope_note) %></p>
  </div>
</section>

<%# 3b · Why choose … — per-protocol heading + numbered reasons (Admin →
      Protocols). Hidden when the protocol has no points in this language. %>
<% why = p.why_points_for_locale %>
<% if why.any? %>
<section class="section section--surface proto-detail proto-why" data-controller="reveal">
  <div class="section-inner split">
    <div class="split-text reveal" data-reveal-target="item">
      <h2 class="proto-why-title"><%= p.why_title.presence || t("protocol_page.why_default", name: p.name) %></h2>
    </div>
    <div class="split-text">
      <ul class="rows">
        <% why.each_with_index do |point, i| %>
          <% label, rest = point.split(/[:：]/, 2) if point =~ /\A.{2,60}?[:：]\s/ %>
          <li data-reveal="left" data-reveal-delay="<%= 120 + i * 110 %>">
            <span class="n"><%= format("%02d", i + 1) %></span>
            <span class="t"><% if rest %><strong><%= label.strip %></strong>: <%= rest.strip %><% else %><%= point %><% end %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
<% end %>

<%# 3c · Frequently asked — questions placed on this protocol in Admin → FAQ
      ("Where it shows"); heading + subtitle from the shared protocol copy. %>
<% page_faqs = Faq.placed_on("protocol:#{p.slug}").to_a %>
<% if page_faqs.any? %>
<section class="section proto-detail proto-faq" data-controller="reveal">
  <div class="section-inner">
    <div class="sec-head reveal" data-reveal-target="item">
      <h2><%= shared.(:faq) %></h2>
      <h3 class="proto-faq-sub"><%= shared.(:faq_subtitle) %></h3>
    </div>
    <div class="faq-group">
      <% page_faqs.each_with_index do |faq, i| %>
        <details class="faq" data-reveal="up" data-reveal-delay="<%= 140 + i * 110 %>">
          <summary><%= faq.question %> <span class="sign">+</span></summary>
          <div class="faq-a"><%= faq.answer %></div>
        </details>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%# 4 · What's not included ---- %>
<% exclusions = p.excludes.to_s.split(/[.;\n]/).map(&:strip).reject(&:blank?) %>
<% exclusions = [p.excludes.to_s.strip] if exclusions.empty? %>
<section class="section section--surface proto-detail" data-controller="reveal">
  <div class="section-inner split">
    <div class="split-text">
      <span class="eyebrow" data-reveal="fade"><%= t("protocol_page.excludes") %></span>
      <h2 data-reveal="mask" data-reveal-delay="120"><span><%= shared.(:honesty) %></span></h2>
    </div>
    <div class="split-text">
      <ul class="exclude">
        <% exclusions.each_with_index do |item, i| %>
          <li data-reveal="left" data-reveal-delay="<%= 160 + i * 130 %>"><%= item %></li>
        <% end %>
      </ul>
    </div>
  </div>
</section>

<%# 5 · The patient journey — expanding image panels, same component as the
      home "Three pillars of our promise" (ns-expand: hovered card grows and
      its photo zooms; first panel holds the expansion at rest). %>
<section id="patient-journey" class="section section--light" data-controller="reveal">
  <div class="section-inner">
    <div class="sec-head reveal" data-reveal-target="item">
      <span class="eyebrow"><%= t("protocol_page.journey") %></span>
    </div>
    <div class="ns-expand reveal d1" data-reveal-target="item">
      <% journey_imgs = ["site/space/waiting-lounge.webp", "site/space/consultation.webp", "site/space/private-suite.webp", "site/space/treatment.webp"] %>
      <% t("protocol_page.journey_steps").each_with_index do |step, i| %>
        <% num, img = step[:num], journey_imgs[i] %>
        <% title = sec_text("protocol", "template", "journey_#{i + 1}_title").presence || step[:title] %>
        <% body  = sec_text("protocol", "template", "journey_#{i + 1}_body").presence  || step[:body] %>
        <div class="ns-panel">
          <%= image_tag img, alt: title, loading: "lazy" %>
          <div class="ns-panel-copy">
            <span class="num"><%= num %></span>
            <h3><%= title %></h3>
            <p><%= body %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# 6 · One consented patient story ---- %>
<% if p.patient_story.present? && p.patient_story["quote_en"].present? %>
  <section class="section section--surface proto-story" data-controller="reveal">
    <div class="section-inner">
      <div class="pull-band">
        <blockquote data-reveal="scale"><%= p.loc(p.patient_story, "quote").presence || p.patient_story["quote_en"] %></blockquote>
        <p class="by" data-reveal="fade" data-reveal-delay="260">— <%= p.patient_story["initials"] %> · <%= p.name %> · <%= p.patient_story["year"] %></p>
      </div>
    </div>
  </section>
<% end %>

<%# 8 · Final CTA + WhatsApp codeword ---- %>
<section class="cta-center cta-center--tight orn-host" data-controller="reveal">
  <%= render "shared/orn", variant: "rings", pos: "halo", size: 380 %>
  <h2 data-reveal="mask"><span><%= t("protocol_page.begin", name: p.name) %></span></h2>
  <p data-reveal="up" data-reveal-delay="160"><%= t("protocol_page.codeword_html", word: p.codeword) %></p>
  <p data-reveal="up" data-reveal-delay="300">
    <a class="btn" href="<%= whatsapp_url(codeword: p.codeword) %>" target="_blank" rel="noopener"><%= t("protocol_page.send_button", word: p.codeword) %></a>
  </p>
</section>
