<!DOCTYPE html>
<%# Light-only site: data-theme is fixed — the palette lives in tokens.css
    under html[data-theme="light"], with the dark tokens kept as dormant
    fallback should a toggle ever return. %>
<html lang="<%= I18n.locale %>" dir="<%= loc_dir %>" data-theme="light">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "NeuSkin Clinic — Doctor-led skin intelligence, Riyadh" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "NeuSkin is Riyadh's doctor-led skin intelligence clinic for women — protocol-led, consultation-led, quietly luxurious. Every plan is read, written and signed by our medical team." %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <link rel="alternate" hreflang="en" href="<%= page_url_in(:en) %>">
    <link rel="alternate" hreflang="ar" href="<%= page_url_in(:ar) %>">
    <link rel="alternate" hreflang="x-default" href="<%= page_url_in(:en) %>">
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TZ4HN4KB');</script>
    <!-- End Google Tag Manager -->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tokens", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# cursor: custom dot + trailing ring; smoothscroll: Lenis inertia —
      both bail out on touch / reduced-motion and leave defaults alone. %>
  <body data-controller="cursor smoothscroll">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TZ4HN4KB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <%# Intro splash — NS monogram, fades out on first load (intro_controller). %>
    <div class="intro-splash" data-controller="intro">
      <%= image_tag "site/logo-ns.png", class: "mark", alt: "" %>
      <span class="line" style="width:170px"></span>
      <span class="wordmark">NeuSkin<span class="sub">Clinic · Riyadh</span></span>
    </div>
    <%= render "shared/header" %>
    <%= yield %>
    <%= render "shared/footer" %>
    <%= render "shared/floating_book" %>
    <%= render "shared/cookie_banner" %>
  </body>
</html>
